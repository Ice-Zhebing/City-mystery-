{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "city-mystery",
  "main": "dist/cloudflare/index.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "city-mystery-db",
      "database_id": "a11c366e-0a0d-4451-9a80-988e0b9fcf31",
      "migrations_dir": "database/migrations"
    }
  ]
}
